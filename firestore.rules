rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isReception() {
      return signedIn() && request.auth.token.reception == true;
    }

    function isStaff() {
      return isAdmin() || isReception();
    }

    function hasAccount() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownPerson(personId) {
      return signedIn() && (
        request.auth.uid == personId ||
        (hasAccount() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personId == personId)
      );
    }

    function validSelfAccount(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.personId == uid
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'ALUNO'
        && request.resource.data.onboardingStatus == 'PENDENTE_COMPLEMENTO';
    }

    function validSelfPerson(personId) {
      return signedIn()
        && request.auth.uid == personId
        && request.resource.data.personId == personId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'ALUNO'
        && request.resource.data.status == 'ATIVA';
    }

    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if validSelfAccount(uid);
      allow update: if isStaff() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.personId == resource.data.personId
        && request.resource.data.roles == resource.data.roles
      );
      allow delete: if false;
    }

    match /people/{personId} {
      allow read: if isStaff() || ownPerson(personId);
      allow create: if isStaff() || validSelfPerson(personId);
      allow update: if isStaff();
      allow delete: if false;
    }

    match /studentProfiles/{personId} {
      allow read: if isStaff() || ownPerson(personId);
      allow create: if isStaff() || (
        signedIn() && request.auth.uid == personId
        && request.resource.data.personId == personId
        && request.resource.data.onboardingStatus == 'PENDENTE_COMPLEMENTO'
        && request.resource.data.facialStatus == 'PENDENTE'
      );
      allow update: if isStaff();
      allow delete: if false;
    }

    match /enrollments/{personId} {
      allow read: if isStaff() || ownPerson(personId);
      allow create: if isStaff() || (
        signedIn() && request.auth.uid == personId
        && request.resource.data.personId == personId
        && request.resource.data.status == 'PENDENTE'
        && request.resource.data.validUntil == null
      );
      allow update: if isStaff();
      allow delete: if false;
    }

    match /guardianLinks/{linkId} {
      allow read: if isStaff()
        || ownPerson(resource.data.guardianPersonId)
        || ownPerson(resource.data.dependentPersonId);
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /billingCycles/{cycleId} {
      allow read: if isStaff() || ownPerson(resource.data.personId);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || ownPerson(resource.data.personId);
      allow write: if false;
    }

    match /externalReceipts/{receiptId} {
      allow read: if isStaff() || ownPerson(resource.data.personId);
      allow write: if false;
    }

    match /dailyAttendance/{attendanceId} {
      allow read: if isStaff() || ownPerson(resource.data.personId);
      allow write: if false;
    }

    match /accessEvents/{eventId} {
      allow read: if isStaff() || ownPerson(resource.data.personId);
      allow write: if false;
    }

    match /academyEvents/{eventId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /termAcceptances/{acceptanceId} {
      allow read: if isStaff()
        || ownPerson(resource.data.personId)
        || ownPerson(resource.data.guardianPersonId);
      allow write: if false;
    }

    match /terms/{termId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /cpfIndex/{indexId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
